/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jeffe-os",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	/**
	 * Workflows
	 * Define Workflows to orchestrate multi-step processes
	 * https://developers.cloudflare.com/workflows/
	 */
	"workflows": [
		{
			"name": "my-workflow",
			"binding": "MY_WORKFLOW",
			"class_name": "MyWorkflow"
		},
		{
			"name": "ai-agent-workflow",
			"binding": "AI_AGENT_WORKFLOW",
			"class_name": "AIAgentWorkflow"
		},
		{
			"name": "orchestrator-workflow",
			"binding": "ORCHESTRATOR_WORKFLOW",
			"class_name": "OrchestratorWorkflow"
		},
		{
			"name": "agent-workflow",
			"binding": "AGENT_WORKFLOW",
			"class_name": "AgentWorkflow"
		},
		{
			"name": "capability-execution-workflow",
			"binding": "CAPABILITY_WORKFLOW",
			"class_name": "CapabilityExecutionWorkflow"
		}
	],
	/**
	 * Durable Objects
	 * Used for WebSocket state management and real-time updates
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "WORKFLOW_STATUS",
				"class_name": "WorkflowStatusDO"
			},
			{
				"name": "AGGREGATOR_DO",
				"class_name": "AggregatorDO"
			}
		]
	},
	/**
	 * Migrations
	 * Required for Durable Objects
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WorkflowStatusDO"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["AggregatorDO"]
		}
	],
	"vars": {
		"PREAPPROVED_GRANTS_JSON": "[]"
	},
	"upload_source_maps": true
}
