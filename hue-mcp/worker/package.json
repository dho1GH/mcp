{
  "name": "hue-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Philips Hue bridge control, deployed on Cloudflare Workers. Proxies to a local executor on the LAN via Cloudflare Tunnel.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "secrets:list": "wrangler secret list"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.21.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.4.0"
  }
}
